+private struct U1MJPEGCamera: UIViewRepresentable {
+    let url: URL
+    let onPlayback: (Bool) -> Void
+
+    final class Coordinator: NSObject, WKScriptMessageHandler {
+        var onPlayback: (Bool) -> Void
+        init(onPlayback: @escaping (Bool) -> Void) { self.onPlayback = onPlayback }
+        func userContentController(_ controller: WKUserContentController, didReceive message: WKScriptMessage) {
+            guard let playing = message.body as? Bool else { return }
+            onPlayback(playing)
+        }
+    }
+
+    func makeCoordinator() -> Coordinator { Coordinator(onPlayback: onPlayback) }
+    func makeUIView(context: Context) -> WKWebView {
+        let config = WKWebViewConfiguration()
+        config.userContentController.add(context.coordinator, name: "cameraPlayback")
+        let view = WKWebView(frame: .zero, configuration: config)
+        view.isOpaque = false
+        view.backgroundColor = .black
+        view.scrollView.isScrollEnabled = false
+        let html = """
+        <!doctype html><html><head><meta name="viewport" content="width=device-width, initial-scale=1">
+        <style>html,body{margin:0;width:100%;height:100%;background:#000}
+        img{width:100%;height:100%;object-fit:contain}</style></head><body>
+        <img id="stream" src="\(url.absoluteString)">
+        <script>
+        (() => {
+          const image = document.getElementById('stream');
+          let reported = false, failed = false;
+          const report = value => window.webkit.messageHandlers.cameraPlayback.postMessage(value);
+          image.onerror = () => { if (!failed) { failed = true; report(false); } };
+          const timer = setInterval(() => {
+            if (!reported && image.naturalWidth > 0) {
+              reported = true; report(true);
+            }
+          }, 250);
+          setTimeout(() => { if (!reported && !failed) { failed = true; report(false); } }, 10000);
+          window.addEventListener('pagehide', () => clearInterval(timer), {once:true});
+        })();
+        </script></body></html>
+        """
+        view.loadHTMLString(html, baseURL: url.deletingLastPathComponent())
+        return view
+    }
+    func updateUIView(_ view: WKWebView, context: Context) { context.coordinator.onPlayback = onPlayback }
+    static func dismantleUIView(_ view: WKWebView, coordinator: Coordinator) {
+        view.configuration.userContentController.removeScriptMessageHandler(forName: "cameraPlayback")
+        view.stopLoading()
+        view.loadHTMLString("", baseURL: nil)
+    }
+}
