+    private var turntableInstruction: String {
+        switch pass {
+        case .around:
+            return "Deixe o iPhone na altura do meio. Gire a peça uma volta completa."
+        case .above:
+            return "Pare o prato, incline o iPhone para baixo e fixe-o. Gire a peça mais uma volta."
+        case .underside:
+            return "Vire a peça, fixe o iPhone mirando a parte de baixo e gire mais uma volta."
+        }
+    }
+
+    private var canChooseMode: Bool {
+        guard let capture else { return false }
+        if case .ready = capture.state { return true }
+        return false
+    }
+
+    private var lightingControls: some View {
+        VStack(alignment: .leading, spacing: 8) {
+            HStack {
+                Toggle(isOn: $torchEnabled) {
+                    Label("Lanterna", systemImage: torchEnabled ? "flashlight.on.fill" : "flashlight.off.fill")
+                }
+                .onChange(of: torchEnabled) { _, enabled in updateCameraControls(torch: enabled) }
+            }
+            if torchEnabled {
+                HStack {
+                    Image(systemName: "flashlight.on.fill")
+                    Slider(value: $torchLevel, in: 0.1...1.0)
+                        .onChange(of: torchLevel) { _, _ in updateCameraControls() }
+                    Text("\(Int(torchLevel * 100))%")
+                        .font(.caption.monospacedDigit())
+                        .frame(width: 42, alignment: .trailing)
+                }
+            }
+            HStack {
+                Image(systemName: "sun.min")
+                Slider(value: $exposureBias, in: -2.0...2.0, step: 0.25)
+                    .onChange(of: exposureBias) { _, _ in updateCameraControls() }
+                Image(systemName: "sun.max")
+                Text(String(format: "%+.2f", exposureBias))
+                    .font(.caption.monospacedDigit())
+                    .frame(width: 48, alignment: .trailing)
+            }
+            Text("Claridade da câmera. Evite brilho forte, sombras duras e reflexos na peça.")
+                .font(.caption).foregroundStyle(.secondary)
+        }
+        .padding(10)
+        .background(.thinMaterial, in: RoundedRectangle(cornerRadius: 12))
+    }
+
+    private func updateCameraControls(torch: Bool? = nil) {
+        guard let device = AVCaptureDevice.default(.builtInWideAngleCamera, for: .video, position: .back) else {
+            errorMessage = "A câmera traseira não está disponível para ajustar a luz."
+            torchEnabled = false
+            return
+        }
+        do {
+            try device.lockForConfiguration()
+            defer { device.unlockForConfiguration() }
+            if let torch {
+                if torch {
+                    guard device.hasTorch && device.isTorchAvailable else {
+                        torchEnabled = false
+                        errorMessage = "A lanterna não está disponível durante esta captura. Use uma luz externa."
+                        return
+                    }
+                    try device.setTorchModeOn(level: Float(torchLevel))
+                } else {
+                    device.torchMode = .off
+                }
+            } else if torchEnabled && device.hasTorch && device.isTorchAvailable {
+                try device.setTorchModeOn(level: Float(torchLevel))
+            }
+            let bias = Float(exposureBias)
+            let supportedBias = min(max(bias, device.minExposureTargetBias), device.maxExposureTargetBias)
+            device.setExposureTargetBias(supportedBias, completionHandler: nil)
+            errorMessage = nil
+        } catch {
+            errorMessage = "Não foi possível ajustar a câmera nesta captura: \(error.localizedDescription)"
+            if torch == true { torchEnabled = false }
+        }
+    }
+
+    private func resetCameraControls() {
+        guard let device = AVCaptureDevice.default(.builtInWideAngleCamera, for: .video, position: .back),
+              (try? device.lockForConfiguration()) != nil else { return }
+        defer { device.unlockForConfiguration() }
+        if device.hasTorch { device.torchMode = .off }
+        device.setExposureTargetBias(0, completionHandler: nil)
+    }
+
     private func close() {
+        resetCameraControls()
         if !reconstructing && modelURL == nil { capture?.cancel() }
         onClose()
     }
