+                        .onChange(of: torchLevel) { _, _ in updateCameraControls() }
+                    Text("\(Int(torchLevel * 100))%")
+                        .font(.caption.monospacedDigit())
+                        .frame(width: 42, alignment: .trailing)
+                }
