+import assert from 'node:assert/strict';
+import {addPrimeTower} from './kiri/src/kiri/mode/fdm/work/prime-tower.js';
+const layer=(tools,z)=>{const p=[];for(const tool of tools)p.push({point:{x:0,y:0,z},emit:0,tool,type:'shells'},{point:{x:10,y:0,z},emit:1,tool,type:'shells'});p.z=z;p.height=.2;return p;};
+function job(layers){return {output:layers,settings:{bounds:{min:{x:0,y:0,z:0},max:{x:10,y:10,z:1}},device:{bedWidth:270,bedDepth:270,extruders:Array.from({length:4},()=>({extNozzle:.4}))},process:{firstLayerRate:30,outputFeedrate:100,outputSeekrate:300}}};}
+const mono=job([layer([0],.2),layer([0],.4)]),unchanged=JSON.stringify(mono.output);
+assert.equal(addPrimeTower(mono).enabled,false);assert.equal(JSON.stringify(mono.output),unchanged);
+const p=job([layer([0],.2),layer([0,3],.4),layer([0,3,0],.6)]);
+const originals=p.output.map(path=>path.filter(o=>o.emit>0));
+const stats=addPrimeTower(p);assert.equal(stats.slots,3);assert.equal(stats.layers,3);assert.equal(stats.primedRuns,6);
+for(let i=0;i<p.output.length;i++){
+ const path=p.output[i];assert.equal(path.z,[.2,.4,.6][i]);
+ let prev,seenTower=false;
+ const model=[];const slots=new Set();
+ for(const o of path){
+  if(o.type==='purge tower'&&o.emit>0){
+   assert.ok(o.point.x>=stats.x&&o.point.x<=stats.x+stats.width);
+   assert.ok(o.point.y>=stats.y&&o.point.y<=stats.y+stats.height);
+   assert.ok(o.point.x>=-132&&o.point.x<=132&&o.point.y>=-132&&o.point.y<=132);
+   slots.add(Math.floor((o.point.x-stats.x)/17)+2*Math.floor((o.point.y-stats.y)/17));seenTower=true;
+  }else if(o.emit>0){assert.ok(seenTower);assert.deepEqual(prev,{x:0,y:0,z:[.2,.4,.6][i]});model.push(o);seenTower=false;}
+  if(o.point)prev=o.point;
+ }
+ assert.equal(slots.size,3,'All slots must start on layer one');
+ assert.deepEqual(model,originals[i]);
+}
+const full=job([layer([0,1],.2)]);full.output[0][0].point.x=-131;full.output[0][0].point.y=-131;full.output[0][1].point.x=131;full.output[0][1].point.y=131;
+assert.throws(()=>addPrimeTower(full),/No room/);
+console.log('PASS: automatic multi-tool tower, single-tool unchanged, late color starts, repeated tools, bed/collision limits, all-layer base, original extrusion segments preserved');
