new file mode 100644
index 0000000..1eb18ff
--- /dev/null
+++ b/ios/Tools/MakerWorldLinkTests.swift
@@ -0,0 +1,25 @@
+import Foundation
+
+@main
+struct MakerWorldLinkTests {
+    static func main() {
+        let good = "https://makerworld.bblmw.com/model/test.3mf?token=a%2Bb&expires=123"
+        var parts = URLComponents(string: "bambustudio://open")!
+        parts.queryItems = [URLQueryItem(name: "file", value: good)]
+        precondition(MakerWorldLinks.modelURL(parts.url!)?.absoluteString == good)
+        let encoded = good.addingPercentEncoding(withAllowedCharacters: .alphanumerics)!
+        precondition(MakerWorldLinks.modelURL(URL(string: "bambustudioopen://" + encoded)!)?.absoluteString == good)
+        for bad in ["http://makerworld.com/a.3mf", "https://makerworld.com.evil.test/a.3mf",
+                    "https://evil.test/a.3mf", "https://user@makerworld.com/a.3mf",
+                    "https://makerworld.com:8080/a.3mf", "file:///a.3mf"] {
+            parts.queryItems = [URLQueryItem(name: "file", value: bad)]
+            precondition(MakerWorldLinks.modelURL(parts.url!) == nil)
+        }
+        parts.queryItems = [URLQueryItem(name: "file", value: good), URLQueryItem(name: "file", value: good)]
+        precondition(MakerWorldLinks.modelURL(parts.url!) == nil)
+        precondition(MakerWorldLinks.modelURL(URL(string: "bambustudio://other?file=x")!) == nil)
+        precondition(MakerWorldLinks.isPage(URL(string: "https://makerworld.com/pt/models/123")!))
+        precondition(!MakerWorldLinks.isPage(URL(string: "https://bblmw.com/")!))
+        print("MakerWorld link validation passed (12 checks)")
+    }
+}
