+private struct U1InlineCamera: UIViewRepresentable {
+    let url: URL
+    let onPlayback: (Bool) -> Void
+
+    final class Coordinator: NSObject, WKScriptMessageHandler, WKNavigationDelegate {
+        var onPlayback: (Bool) -> Void
+        init(onPlayback: @escaping (Bool) -> Void) { self.onPlayback = onPlayback }
+        func userContentController(_ controller: WKUserContentController, didReceive message: WKScriptMessage) {
+            guard let playing = message.body as? Bool else { return }
+            onPlayback(playing)
+        }
+        func webView(_ webView: WKWebView, didFailProvisionalNavigation navigation: WKNavigation!, withError error: Error) {
+            if (error as NSError).code != NSURLErrorCancelled { onPlayback(false) }
+        }
+        func webView(_ webView: WKWebView, didFail navigation: WKNavigation!, withError error: Error) {
+            if (error as NSError).code != NSURLErrorCancelled { onPlayback(false) }
+        }
+    }
+
+    func makeCoordinator() -> Coordinator { Coordinator(onPlayback: onPlayback) }
+    func makeUIView(context: Context) -> WKWebView {
+        let config = WKWebViewConfiguration()
+        config.allowsInlineMediaPlayback = true
+        config.mediaTypesRequiringUserActionForPlayback = []
+        config.userContentController.add(context.coordinator, name: "cameraPlayback")
+        // Observe decoded frames, not merely an HTTP success or an ICE connection.
+        let script = """
+        (() => {
+          let lastTime = -1, lastFrame = Date.now(), reported = false;
+          const timer = setInterval(() => {
+            const video = document.querySelector('video');
+            if (video && video.readyState >= 2 && video.currentTime > lastTime) {
+              lastTime = video.currentTime; lastFrame = Date.now();
+              if (!reported) { window.webkit.messageHandlers.cameraPlayback.postMessage(true); reported = true; }
+            }
+            if (Date.now() - lastFrame > 20000) {
+              clearInterval(timer); window.webkit.messageHandlers.cameraPlayback.postMessage(false);
+            }
+          }, 1000);
+          window.addEventListener('pagehide', () => clearInterval(timer), {once:true});
+        })();
+        """
+        config.userContentController.addUserScript(WKUserScript(source: script, injectionTime: .atDocumentEnd, forMainFrameOnly: true))
+        let view = WKWebView(frame: .zero, configuration: config)
+        view.navigationDelegate = context.coordinator
+        view.isOpaque = false
+        view.backgroundColor = .black
+        view.scrollView.isScrollEnabled = false
+        view.load(URLRequest(url: url, timeoutInterval: 15))
+        return view
+    }
+    func updateUIView(_ view: WKWebView, context: Context) { context.coordinator.onPlayback = onPlayback }
+    static func dismantleUIView(_ view: WKWebView, coordinator: Coordinator) {
+        view.configuration.userContentController.removeScriptMessageHandler(forName: "cameraPlayback")
+        view.navigationDelegate = nil
+        view.stopLoading()
+        view.loadHTMLString("", baseURL: nil)
+    }
+}
