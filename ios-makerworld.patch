diff --git a/engine/test-model-xml.mjs b/engine/test-model-xml.mjs
new file mode 100644
index 0000000..430506f
--- /dev/null
+++ b/engine/test-model-xml.mjs
@@ -0,0 +1,18 @@
+import assert from 'node:assert/strict';
+import { parseModelXML } from './snapslice-model-xml.js';
+const wrap = body => `<model xmlns="http://schemas.microsoft.com/3dmanufacturing/core/2015/02" unit="millimeter"><resources><object id="1"><mesh>${body}</mesh></object></resources><build><item objectid="1"/></build></model>`;
+const vertices = '<vertices><vertex x="0" y="0" z="0"/><vertex x="2" y="0" z="0"/><vertex x="0" y="3" z="0"/></vertices>';
+const triangle = '<triangle v1="0" v2="1" v3="2"/>';
+const geometry = text => parseModelXML(text,{millimeter:1}).children[0].children[0].children[0].geometry;
+const plain = geometry(wrap(vertices+`<triangles>${triangle}</triangles>`));
+assert.deepEqual([...plain.faces],[0,0,0,2,0,0,0,3,0]);
+assert.equal(plain.paintFaces,plain.faces);
+assert.equal(plain.painted,false);
+assert.throws(()=>geometry(wrap(vertices+'<triangles><triangle v1="-1" v2="1" v3="2"/></triangles>')),/index/);
+assert.throws(()=>geometry(wrap(vertices+'<triangles><triangle v1="0" v2="1" v3="9"/></triangles>')),/index/);
+assert.throws(()=>geometry(wrap(vertices+'<triangles>')),/XML/);
+assert.throws(()=>geometry('<!DOCTYPE model>'+wrap(vertices)),/DOCTYPE/);
+const large = geometry(wrap(vertices+`<triangles>${triangle.repeat(1_000_001)}</triangles>`));
+assert.equal(large.faces.length,1_000_001*9);
+assert.deepEqual([...large.faces.slice(-9)],[0,0,0,2,0,0,0,3,0]);
+console.log('PASS: packed XML, invalid indices/XML, DTD rejection, and >1M intact triangles');
diff --git a/engine/test-negative-volumes.mjs b/engine/test-negative-volumes.mjs
new file mode 100644
index 0000000..aa831db
--- /dev/null
+++ b/engine/test-negative-volumes.mjs
@@ -0,0 +1,37 @@
+import {build} from 'esbuild';
+import {readFile} from 'node:fs/promises';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+import vm from 'node:vm';
+import assert from 'node:assert/strict';
+import * as THREE from 'three';
+const root=path.dirname(fileURLToPath(import.meta.url));
+const result=await build({stdin:{contents:`
+import './kiri/src/add/array.js';
+import {sliceWithCuts,cuttingPoints} from './kiri/src/kiri/mode/fdm/work/negative.js';
+import {polygons as POLY} from './kiri/src/geo/polygons.js';
+import {slicer} from './kiri/src/geo/slicer.js';
+function box(x,y,z,w,h,d) {
+ const v=[[x,y,z],[x+w,y,z],[x+w,y+h,z],[x,y+h,z],[x,y,z+d],[x+w,y,z+d],[x+w,y+h,z+d],[x,y+h,z+d]];
+ const f=[[0,2,1],[0,3,2],[4,5,6],[4,6,7],[0,1,5],[0,5,4],[1,2,6],[1,6,5],[2,3,7],[2,7,6],[3,0,4],[3,4,7]];
+ return Float32Array.from(f.flatMap(t=>t.flatMap(i=>v[i])));
+}
+const area=r=>POLY.nest(r.groups).reduce((s,p)=>s+p.areaDeep(),0);
+const close=(a,b)=>assert.ok(Math.abs(a-b)<0.0001,a+' != '+b);
+globalThis.testPromise=(async()=>{
+ const positive=box(0,0,0,10,10,10),cut=box(2,2,-1,4,4,12);
+ const layer=z=>cuttingPoints(positive,z);
+ close(area(await sliceWithCuts(5,layer(5),{},[cut])),84);
+ close(area(await sliceWithCuts(5,layer(5),{},[cut,box(4,2,-1,4,4,12)])),76);
+ close(area(await sliceWithCuts(5,layer(5),{},[box(20,20,0,4,4,10)])),100);
+ close(area(await sliceWithCuts(5,layer(5),{},[box(-1,-1,-1,12,12,12)])),0);
+ close(area(await sliceWithCuts(8,layer(8),{},[box(2,2,0,4,4,6)])),100);
+ let count=0;
+ slicer.slicePost.TEST=r=>{close(area(r),84);r.checked=true};
+ await sliceWithCuts([2,4,6],layer(5),{post:'TEST',each:r=>{assert.equal(r.checked,true);count++}},[cut]);
+ assert.equal(count,3);
+ console.log('PASS: holes, overlapping cutters, disjoint cutters, complete removal, height bounds, and post-processing order');
+})();`,resolveDir:root,sourcefile:'negative-regression.js'},bundle:true,write:false,format:'iife',platform:'browser',target:'es2022',plugins:[{name:'earcut-package',setup(b){b.onResolve({filter:/earcut\.js$/},()=>({path:path.join(root,'node_modules/earcut/src/earcut.js')}));}}]});
+const context=vm.createContext({THREE,assert,console,navigator:{userAgent:'node'}});context.self=context;
+vm.runInContext(result.outputFiles[0].text,context);
+await context.testPromise;
diff --git a/engine/test-paint-search.mjs b/engine/test-paint-search.mjs
new file mode 100644
index 0000000..a53a374
--- /dev/null
+++ b/engine/test-paint-search.mjs
@@ -0,0 +1,26 @@
+import assert from 'node:assert/strict';
+import {Triangle,Vector3} from 'three';
+import {paintPreparedPaths} from './kiri/src/kiri/mode/fdm/work/paint-paths.js';
+let seed=42;const rand=()=>((seed=(seed*1664525+1013904223)>>>0)/4294967296);
+const vertices=[],paint=[];
+for(let i=0;i<1200;i++){
+ const x=rand()*40,y=rand()*40,z=rand()*8;
+ vertices.push(x,y,z,x+0.5,y,z,x,y+0.5,z);paint.push(1+i%4);
+}
+const mesh={vertices:Float32Array.from(vertices),paint:Uint8Array.from(paint),scale:1.3,x:7,y:-9,defaultTool:2};
+const transformed=mesh.vertices.map((v,i)=>v*mesh.scale+(i%3===0?mesh.x:i%3===1?mesh.y:0));
+const triangles=paint.map((_,i)=>new Triangle(...[0,3,6].map(j=>new Vector3(...transformed.subarray(i*9+j,i*9+j+3)))));
+const expected=[],output=[];
+for(let i=0;i<180;i++){
+ const p=new Vector3(rand()*54+7,rand()*54-9,rand()*12),target=new Vector3();
+ let best=1.1*1.1,tool=2;
+ triangles.forEach((t,j)=>{t.closestPointToPoint(p,target);const d=target.distanceToSquared(p);if(d<best){best=d;tool=paint[j]-1}});
+ expected.push(tool);
+ output.push([{point:{x:p.x-.01,y:p.y,z:p.z},emit:0,type:'shells'}, {point:{x:p.x+.01,y:p.y,z:p.z},emit:1,speed:20}]);
+}
+const print={output,settings:{process:{outputSeekrate:100}}};
+const stats=paintPreparedPaths(print,[mesh]);
+print.output.forEach((path,i)=>assert.equal(path.find(p=>p.emit>0).tool,expected[i],`query ${i}`));
+assert.equal(stats.beforeMoves,180);assert.equal(stats.afterMoves,180);
+assert.ok(Math.abs(stats.beforeLength-stats.afterLength)<1e-8);
+console.log('PASS: BVH color matches brute-force nearest faces with scaling, offsets, all four tools and fallback; extrusion unchanged');
