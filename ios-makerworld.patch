@@ -0,0 +1,42 @@
+import { newPoint } from '../../../../geo/point.js';
+import { polygons as POLY } from '../../../../geo/polygons.js';
+import { sliceZ, slicer } from '../../../../geo/slicer.js';
+
+// Slice only triangles crossing this height; keep the large cutter meshes packed.
+export function cuttingPoints(faces, z) {
+    if (!ArrayBuffer.isView(faces) || !faces.length || faces.length%9) throw Error('Invalid cutting-volume buffer.');
+    const points=[];
+    for(let i=0;i<faces.length;i+=9) {
+        const a=faces[i+2],b=faces[i+5],c=faces[i+8];
+        if(z<Math.min(a,b,c)-0.0001 || z>Math.max(a,b,c)+0.0001) continue;
+        for(let j=0;j<9;j+=3) points.push(newPoint(faces[i+j],faces[i+j+1],faces[i+j+2]));
+    }
+    return points;
+}
+
+export async function sliceWithCuts(z, points, options, cutters) {
+    if(Array.isArray(z)) {
+        // Bound intermediate memory instead of processing all cutter layers at once.
+        const out=[];
+        for(const height of z) out.push(await sliceWithCuts(height,points,options,cutters));
+        return out;
+    }
+    const raw={...options,post:undefined,each:undefined};
+    const result=await sliceZ(z,points,raw);
+    if(!result) return result;
+    let solids=POLY.nest(result.groups);
+    // Subtract separately: overlapping negative volumes must not cancel by parity.
+    for(const faces of cutters) {
+        if(!solids.length) break;
+        const cut=await sliceZ(z,cuttingPoints(faces,z),{...raw,union:true});
+        if(!cut?.groups?.length) continue;
+        const next=[];
+        POLY.subtract(solids,POLY.nest(cut.groups),next,null,z,0.000001);
+        solids=next;
+    }
+    result.groups=POLY.flatten(solids,[],true);
+    // Shells, supports and infill must all see the already-cut cross section.
+    if(options.post) slicer.slicePost[options.post](result,options);
+    options.each?.(result);
+    return result;
+}
