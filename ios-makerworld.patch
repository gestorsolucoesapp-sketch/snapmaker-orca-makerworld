+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+
+
+const swift = await readFile(new URL('../ios/SnapSliceNativeHarness/KiriSliceEngine.swift', import.meta.url), 'utf8');
+const inspect = swift.slice(swift.indexOf('func inspect('));
+const script = inspect.match(/callAsyncJavaScript\(\s*"""([\s\S]*?)"""/)[1];
+const execute = new Function('window', 'request', `return (async () => {${script}})()`);
+
+const expected = JSON.stringify({size: [20, 20, 20], parts: [{vertices: [0, 0, 0]}]});
+assert.equal(await execute({snapSliceKiri: {inspect: async () => expected}}, {}), expected);
+for (const thrown of [new Error('Missing 3MF resource'), 'Invalid ZIP', null]) {
+    const result = await execute({snapSliceKiri: {inspect: async () => { throw thrown; }}}, {});
+    assert.equal(typeof result.snapSliceError, 'string');
