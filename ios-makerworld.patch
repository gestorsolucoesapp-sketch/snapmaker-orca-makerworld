@@ -0,0 +1,103 @@
+// Add a physical priming tower after all painted/support tools are finalized.
+// Coordinates are the centered bed coordinates used by prepared Kiri paths.
+export function addPrimeTower(print) {
+    const paths=print.output, {device,process}=print.settings;
+    const used=new Set();
+    const bounds={minX:Infinity,minY:Infinity,maxX:-Infinity,maxY:-Infinity};
+    const runs=paths.map(path=>{
+        let last,previous,count=0;
+        for(const out of path) {
+            if(out.point && out.emit>0) {
+                const tool=out.tool ?? 0;
+                used.add(tool);
+                if(tool!==last){count++;last=tool;}
+                for(const p of [previous,out.point]) if(p){
+                    bounds.minX=Math.min(bounds.minX,p.x);bounds.maxX=Math.max(bounds.maxX,p.x);
+                    bounds.minY=Math.min(bounds.minY,p.y);bounds.maxY=Math.max(bounds.maxY,p.y);
+                }
+            }
+            if(out.point) previous=out.point;
+        }
+        return count;
+    });
+    if(used.size<2) return {enabled:false,reason:'single-tool'};
+    const slots=Math.max(...runs);
+    if(slots>16 || device.bedBelt || device.bedRound) throw Error('Unsupported priming tower layout.');
+    const side=16,gap=1,clearance=5,margin=3;
+    const cols=Math.ceil(Math.sqrt(slots)),rows=Math.ceil(slots/cols);
+    const width=cols*side+(cols-1)*gap,height=rows*side+(rows-1)*gap;
+    const minX=-device.bedWidth/2+margin,maxX=device.bedWidth/2-margin;
+    const minY=-device.bedDepth/2+margin,maxY=device.bedDepth/2-margin;
+    const midX=(bounds.minX+bounds.maxX-width)/2,midY=(bounds.minY+bounds.maxY-height)/2;
+    const candidates=[
+        [bounds.maxX+clearance,midY],[bounds.minX-clearance-width,midY],
+        [midX,bounds.maxY+clearance],[midX,bounds.minY-clearance-height],
+        [minX,minY],[maxX-width,minY],[minX,maxY-height],[maxX-width,maxY-height]
+    ];
+    const location=candidates.find(([x,y])=>x>=minX && y>=minY && x+width<=maxX && y+height<=maxY &&
+        (x+width<=bounds.minX-clearance || x>=bounds.maxX+clearance || y+height<=bounds.minY-clearance || y>=bounds.maxY+clearance));
+    if(!location) throw Error('No room for the purge tower. Move or reduce the model and slice again.');
+    let towerMoves=0,primedRuns=0;
+    for(let layer=0;layer<paths.length;layer++) {
+        const path=paths[layer];
+        if(!runs[layer]) throw Error('Cannot bridge an empty layer below the purge tower.');
+        const output=[];
+        let previous,lastTool,slot=0,feature='';
+        const emitSlot=(index,tool,start,dense)=>{
+            const nozzle=device.extruders[tool].extNozzle;
+            if(!(nozzle>0 && nozzle<=1)) throw Error('Invalid tower nozzle.');
+            const x=location[0]+(index%cols)*(side+gap),y=location[1]+Math.floor(index/cols)*(side+gap);
+            const z=start.z,rate=Math.min(40,layer===0?process.firstLayerRate:process.outputFeedrate);
+            const point=(px,py)=>{
+                const p=start.clone ? start.clone() : {...start};p.x=px;p.y=py;p.z=z;return p;
+            };
+            const push=(px,py,emit)=>{
+                output.push({point:point(px,py),emit,speed:emit?rate:process.outputSeekrate,tool,type:'purge tower'});
+                if(emit)towerMoves++;
+            };
+            if(output.length) output[output.length-1].retract=true;
+            // Two walls give the tower a stable perimeter on every layer.
+            for(let wall=0;wall<2;wall++) {
+                const inset=nozzle/2+wall*nozzle,a=x+inset,b=y+inset,c=x+side-inset,d=y+side-inset;
+                push(a,b,0);push(c,b,1);push(c,d,1);push(a,d,1);push(a,b,1);
+            }
+            const inset=nozzle*2.5,a=x+inset,b=y+inset,c=x+side-inset,d=y+side-inset;
+            const step=dense?nozzle:nozzle*5;
+            let flip=false;
+            for(let t=b;t<=d+1e-6;t+=step){
+                // Alternate direction between layers for a supported cross-hatch.
+                const ax=flip?c:a,bx=flip?a:c;
+                if(layer%2){push(x+(t-y),y+(ax-x),0);push(x+(t-y),y+(bx-x),1);}
+                else {push(ax,t,0);push(bx,t,1);}
+                flip=!flip;
+            }
+            output[output.length-1].retract=true;
+        };
+        for(const out of path) {
+            if(out.type) feature=out.type;
+            if(out.point && out.emit>0 && (out.tool??0)!==lastTool) {
+                if(!previous) throw Error('Missing start point before tower priming.');
+                const tool=out.tool??0;
+                emitSlot(slot++,tool,previous,true);primedRuns++;
+                // Restore exactly the start of the original extrusion segment.
+                output.push({point:previous,emit:0,speed:process.outputSeekrate,tool,type:feature,widget:out.widget});
+                lastTool=tool;
+            }
+            output.push(out);
+            if(out.point) previous=out.point;
+        }
+        // Build unused slots from layer one; later color changes never print in air.
+        while(slot<slots) emitSlot(slot++,lastTool,previous,layer===0);
+        // Restore the original layer endpoint for Kiri's following layer travel.
+        output.push({point:previous,emit:0,speed:process.outputSeekrate,tool:lastTool,type:feature});
+        path.length=0;
+        for(const out of output) path.push(out);
+    }
+    if(print.settings.bounds) {
+        const b=print.settings.bounds;
+        b.min.x=Math.min(b.min.x,location[0]);b.min.y=Math.min(b.min.y,location[1]);
+        b.max.x=Math.max(b.max.x,location[0]+width);b.max.y=Math.max(b.max.y,location[1]+height);
+    }
+    print.primeTower={enabled:true,x:location[0],y:location[1],width,height,slots,layers:paths.length,primedRuns,towerMoves};
+    return print.primeTower;
+}
