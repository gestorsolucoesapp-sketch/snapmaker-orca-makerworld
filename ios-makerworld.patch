+}
+const malformed = await execute({snapSliceKiri: {inspect: async () => new Float32Array([1, 2])}}, {});
+assert.match(malformed.snapSliceError, /did not return model JSON/);
+const oversized = await execute({snapSliceKiri: {inspect: async () => { throw new Error('The 3MF model is too large.'); }}}, {});
+assert.match(oversized.snapSliceError, /160 MB por recurso ou 180 MB no total/);
+console.log('PASS: preview bridge preserves JSON and reports Error, string, null and invalid results');
