--- /dev/null
+++ b/engine/snapslice-model-xml.js
@@ -0,0 +1,88 @@
+import { SaxesParser } from 'saxes';
+import { paintPatches } from './snapslice-paint.js';
+
+export const MAX_TRIANGLES = 2_000_000;
+// Keep geometry in packed buffers instead of millions of DOM nodes and JS arrays.
+class BufferBuilder {
+    constructor(max) { this.max = max; this.length = 0; this.data = new Float32Array(Math.min(4096, max)); }
+    add(values) {
+        const size = this.length + values.length;
+        if (size > this.max) throw Error('The 3MF exceeds the on-device geometry limit.');
+        if (size > this.data.length) {
+            const next = new Float32Array(Math.min(this.max, Math.max(size, this.data.length * 2)));
+            next.set(this.data); this.data = next;
+        }
+        this.data.set(values, this.length); this.length = size;
+    }
+    finish() { return this.data.slice(0, this.length); }
+}
+
+export function parseModelXML(text, unitTable) {
+    let root, unit, mesh, nodeCount = 0;
+    const stack = [];
+    const parser = new SaxesParser({ xmlns: true });
+    parser.on('doctype', () => { throw Error('DOCTYPE is not supported in 3MF.'); });
+    parser.on('error', error => { throw Error(`Invalid 3MF XML: ${error.message}`); });
+    parser.on('opentag', tag => {
+        const attributes = Object.values(tag.attributes);
+        const get = name => attributes.find(a => a.local === name)?.value ?? null;
+        const name = tag.local;
+        const parent = stack.at(-1);
+        if (name === 'vertex' && parent?.localName === 'vertices' && mesh) {
+            const xyz = ['x','y','z'].map(key => get(key) === null ? NaN : Number(get(key)) * unit);
+            if (!xyz.every(Number.isFinite)) throw Error('Invalid 3MF vertex.');
+            mesh.vertices.add(xyz); stack.push({localName: name}); return;
+        }
+        if (name === 'triangle' && parent?.localName === 'triangles' && mesh) {
+            const triangle = ['v1','v2','v3'].map(key => {
+                const raw = get(key), index = Number(raw);
+                if (raw === null || !Number.isInteger(index) || index < 0 || index * 3 + 2 >= mesh.vertices.length)
+                    throw Error('Invalid 3MF triangle index.');
+                return mesh.vertices.data.subarray(index * 3, index * 3 + 3);
+            });
+            for (const point of triangle) mesh.faces.add(point);
+            const paint = get('paint_color');
+            // Lazily allocate paint buffers; plain models never need a second mesh.
+            if (paint !== null && !mesh.painted) {
+                mesh.painted = true;
+                mesh.paintFaces = new BufferBuilder(1_500_000 * 9);
+                mesh.paintFaces.add(mesh.faces.data.subarray(0, mesh.faces.length - 9));
+                mesh.paintStates = new Uint8Array(1_500_000);
+                mesh.paintCount = mesh.faces.length / 9 - 1;
+            }
+            if (mesh.painted) {
+                for (const patch of paintPatches(paint ?? undefined, triangle)) {
+                    if (mesh.paintCount >= 1_500_000) throw Error('The 3MF paint detail is too complex.');
+                    for (const point of patch.triangle) mesh.paintFaces.add(point);
+                    mesh.paintStates[mesh.paintCount++] = patch.state;
+                }
+            }
+            stack.push({localName: name}); return;
+        }
+        if (++nodeCount > 100_000) throw Error('The 3MF has too many structural elements.');
+        const node = {localName:name, children:[], attributes:attributes.map(a=>({localName:a.local,value:a.value})),
+            getAttribute:get, hasAttribute:name=>get(name)!==null};
+        if (!root) {
+            if (name !== 'model') throw Error('Invalid 3MF model root.');
+            root = node; unit = unitTable[get('unit') || 'millimeter'];
+            if (!unit) throw Error('Unsupported 3MF units.');
+        }
+        parent?.children?.push(node); stack.push(node);
+        if (name === 'mesh') {
+            if (mesh) throw Error('Nested 3MF meshes are invalid.');
+            mesh = {vertices:new BufferBuilder(MAX_TRIANGLES * 9), faces:new BufferBuilder(MAX_TRIANGLES * 9), painted:false};
+        }
+    });
+    parser.on('closetag', tag => {
+        const node = stack.pop();
+        if (tag.local === 'mesh') {
+            const faces = mesh.faces.finish();
+            node.geometry = {faces, paintFaces:mesh.painted ? mesh.paintFaces.finish() : faces,
+                paint:mesh.painted ? mesh.paintStates.slice(0,mesh.paintCount) : new Uint8Array(faces.length / 9), painted:mesh.painted};
+            mesh = null;
+        }
+    });
+    for (let i = 0; i < text.length; i += 65536) parser.write(text.slice(i, i + 65536));
+    parser.close();
+    return root;
+}
